# 运行时产物
logs/*
!logs/.htaccess
!logs/cache/.gitkeep
!logs/nonce/.gitkeep
# 注意：logs/.htaccess、logs/cache/.gitkeep、logs/nonce/.gitkeep 必须真实提交，
# 否则分发包没有 logs 目录骨架，安装器 is_writable 检查直接失败
install/install.lock
yanzheng_blank.zip

# 运行时生成的密钥与数据
config/grace_keys.php
data/file_baseline.json
data/backups/*
!data/backups/.gitkeep

# 测试证书由 tests/wechat_v3_notify_test.php 运行时自动生成（仅测试用，勿入库）
tests/_certs/

# 用户上传文件
uploads/shop/*
uploads/web/*
!uploads/shop/.gitkeep
!uploads/web/.gitkeep

# 升级 / 迁移脚本（不随分发包提供）
install/migrate_*.php

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.catpaw/
.freebuff/
.workbuddy/

# 临时文件
*.log
*.tmp
*~

# 打包工作目录与产物
_pkg/
*.zip

# SDK 编译产物
sdk/build/out/
*.obj
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.dll
# 例外：随 SDK 分发的加固工具静态库
!sdk/vmp/*.lib

# SDK 发行版随仓库发布（2026-10-04 起）
# /sdk/        ← 已在 yanzheng 主仓库发布
# /sdk-py/     ← Python SDK
# /sdk-c#/     ← C# SDK  
# /sdk-c++/    ← C++ SDK（header-only）

# 响应签名私钥（2026-10-03 审计：绝不入库）
config/resp_sign_keys.php
