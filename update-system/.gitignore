# 运行时产物
logs/*
!logs/.htaccess
install/install.lock
yanzheng_blank.zip

# 升级 / 迁移脚本
# 这些脚本只用于既有站点升级，不随分发包与仓库提供；
# 需要时直接上传到服务器 install/ 目录执行，用完即可删除。
install/migrate_*.php

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 临时文件
*.log
*.tmp
*~

# SDK 编译产物
sdk/build/out/
*.obj
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.dll

# 敏感配置（含数据库密码，安装后自动生成；仓库内以 config.example.php 占位）
config/config.php

# 密钥文件（Ed25519 私钥，严禁入仓；公钥不敏感可入仓）
storage/updates/update-private-key.pem

# 运行时存储（本机运行产物，不回传仓库）
storage/updates/backups/
storage/updates/logs/
storage/updates/packages/
storage/cache/

# 发布包（大文件，单独上传到服务器 Web 目录）
releases/*/update.zip
releases/*/update.zip.sig
